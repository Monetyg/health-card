# CloudBase 前端环境变量模板
# 复制为 .env.local 并填入真实值后再 npm run build

# 1) CloudBase 云环境 ID（控制台 → 环境概览 → 环境ID）
VITE_TCB_ENV_ID=

# 2) 二维码里的查验地址前缀 = 静态托管域名，必须带 https:// 且不要结尾斜杠
#    例：https://health-card-xxx.tcloudbaseapp.com
#    注意：改成新域名后，旧二维码需要重新生成
VITE_VERIFY_BASE_URL=

# 3) 非微信浏览器的查验通道地址
#    留空则走同域 /api（推荐，CloudBase HTTP 访问服务把 /api 路由到 health-cert-verify）
#    如需独立云函数 HTTP 触发地址，填完整 URL，例：https://xxx.service.tcloudbase.com/verify
VITE_TCB_HTTP_VERIFY=
